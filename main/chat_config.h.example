// main/chat_config.h.example —— 复制成 chat_config.h 再改。
// chat_config.h 已被 .gitignore 忽略,不会误提交你的服务器地址。
//
//     cp main/chat_config.h.example main/chat_config.h
//
// Wi-Fi 不在这里配:设备用手机配网(热点 Tianji-Setup -> http://192.168.4.1),
// 也可以开机后在「设置」页重新配网。
#pragma once

// 你自己的语音后端(server/voice_server.py 跑在哪台机器上)。
// 填域名或公网 IP;局域网自测填电脑的内网地址也行。
#define CHAT_SERVER_HOST "your-server.example.com"
#define CHAT_SERVER_PORT 80

// WebSocket 路径。直连 8765 时填 "/";走 nginx 反代就填反代的路径
// (冷门端口常被家庭网络拦,建议反代到 80/443)。
#define CHAT_SERVER_PATH "/tianji-voice"

// 必须与 server/.env 里的 AUTH_TOKEN 一致。换成一串随机字符。
#define CHAT_AUTH_TOKEN  "change-me-to-a-random-string"
