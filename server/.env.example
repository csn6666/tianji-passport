# 天机 · 语音后端配置
#
# 这个后端只做语音转换,不需要任何 LLM 的 key ——
# 解盘和问事由设备直接调用你在配网页里填的 AI 接口。
#
# ── 设备鉴权(必填)──────────────────────────────────────────
# 自己编一串随机字符,固件 main/chat_config.h 里的 CHAT_AUTH_TOKEN 要一模一样。
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
AUTH_TOKEN=换成一串随机字符

# ── ASR 语音识别 ───────────────────────────────────────────
# local  = 本机跑 faster-whisper。免费,但要装 faster-whisper 且吃 CPU,
#          首次启动会下模型(small 约 500MB)。
# openai = 用你自己的云端 ASR,任何 OpenAI 兼容的 /audio/transcriptions 都行
#          (OpenAI、Groq、硅基流动、通义……)。树莓派/小机器建议用这个。
# custom = 接腾讯云/阿里云/自建服务,实现 voice_server.py 里的
#          custom_transcribe(),详见 docs/INTEGRATIONS.md
ASR_PROVIDER=local
# ASR_PROVIDER=openai 时这三个必填
#ASR_BASE_URL=https://api.groq.com/openai/v1
#ASR_API_KEY=gsk_你自己的
#ASR_MODEL=whisper-large-v3
# ASR_PROVIDER=local 时用哪个模型尺寸(tiny/base/small/medium),越小越快越不准
ASR_LOCAL_MODEL=small

# ── TTS 语音合成 ───────────────────────────────────────────
# edge   = 微软 edge-tts,免费免 key(默认)
# openai = 任何 OpenAI 兼容的 /audio/speech
# custom = 接自己的服务,实现 voice_server.py 里的 custom_tts()
TTS_PROVIDER=edge
# edge 用 zh-CN-XiaoxiaoNeural / zh-CN-YunxiNeural 等;openai 用 alloy / nova 等
TTS_VOICE=zh-CN-XiaoxiaoNeural
#TTS_BASE_URL=
#TTS_API_KEY=
#TTS_MODEL=tts-1

PORT=8765
